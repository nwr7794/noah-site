---
interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
}

const {
  title,
  description = "Noah's Notes — daily writing and long-form essays.",
  activeNav,
} = Astro.props;

const siteTitle = "Noah's Notes";
const pageTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="stylesheet" href={`${base}/styles/global.css`} />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href={`${base}/rss.xml`} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <div class="site-title">
          <a href={`${base}/`}>{siteTitle}</a>
        </div>
        <nav class="site-nav" aria-label="Site navigation">
          <a href={`${base}/daily/`} aria-current={activeNav === 'daily' ? 'page' : undefined}>Daily</a>
          <a href={`${base}/long-form/`} aria-current={activeNav === 'long-form' ? 'page' : undefined}>Long-form</a>
          <a href={`${base}/projects/`} aria-current={activeNav === 'projects' ? 'page' : undefined}>Projects</a>
          <a href={`${base}/rss.xml`}>RSS</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>Noah's Notes</span>
        <a href={`${base}/rss.xml`}>RSS feed</a>
      </div>
    </footer>
  </body>
</html>
