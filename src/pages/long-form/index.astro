---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const posts = (await getCollection('long-form', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<BaseLayout
  title="Long-form"
  description="Longer essays and writing."
  activeNav="long-form"
>
  <div class="page-header">
    <h1 class="page-title">Long-form</h1>
    <p class="page-description">Longer essays and writing.</p>
  </div>

  {posts.length === 0 ? (
    <p class="empty-state">No long-form posts yet.</p>
  ) : (
    <ul class="post-list">
      {posts.map(post => (
        <li class="post-item">
          <div class="post-item-date">{formatDate(post.data.date)}</div>
          <h2 class="post-item-title">
            <a href={`${base}/long-form/${post.id}/`}>{post.data.title}</a>
          </h2>
          {post.data.description && (
            <p class="post-item-description">{post.data.description}</p>
          )}
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
