---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    domain: 'xpansedata.com',
    url: 'https://xpansedata.com',
  },
  {
    domain: 'recipeeper.com',
    url: 'https://recipeeper.com',
  },
];
---

<BaseLayout
  title="Projects"
  description="Live web apps built by Noah."
  activeNav="projects"
>
  <div class="page-header">
    <h1 class="page-title">Projects</h1>
  </div>

  <div class="project-grid" aria-label="Live web apps">
    {projects.map(project => (
      <a class="project-card" href={project.url} target="_blank" rel="noopener noreferrer">
        <span class="project-preview" aria-hidden="true">
          <span class="project-browser-bar">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span class="project-preview-domain">{project.domain}</span>
        </span>
        <span class="project-domain">{project.domain}</span>
      </a>
    ))}
  </div>
</BaseLayout>
